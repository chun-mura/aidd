         with self.assertRaises(NotFound):
             NoteService().read("alice", 99)
 
+    def test_stranger_cannot_read_until_shared(self):
+        service = NoteService()
+        note_id = service.create("alice", "shopping list")
+        with self.assertRaises(PermissionDenied):
+            service.read("bob", note_id)
+        service.share("alice", note_id, "bob")
+        self.assertEqual(service.read("bob", note_id), "shopping list")
+
+    def test_share_applies_only_to_that_note(self):
+        service = NoteService()
+        shared_id = service.create("alice", "shopping list")
+        other_id = service.create("alice", "diary")
+        service.share("alice", shared_id, "bob")
+        with self.assertRaises(PermissionDenied):
+            service.read("bob", other_id)
+
+    def test_sharing_twice_keeps_access(self):
+        service = NoteService()
+        note_id = service.create("alice", "shopping list")
+        service.share("alice", note_id, "bob")
+        service.share("alice", note_id, "bob")
+        self.assertEqual(service.read("bob", note_id), "shopping list")
+
+    def test_owner_sharing_with_self_keeps_access(self):
+        service = NoteService()
+        note_id = service.create("alice", "shopping list")
+        service.share("alice", note_id, "alice")
+        self.assertEqual(service.read("alice", note_id), "shopping list")
+
+    def test_stranger_cannot_share(self):
+        service = NoteService()
+        note_id = service.create("alice", "shopping list")
+        with self.assertRaises(PermissionDenied):
+            service.share("mallory", note_id, "mallory")
+        with self.assertRaises(PermissionDenied):
+            service.read("mallory", note_id)
+
+    def test_shared_user_cannot_reshare(self):
+        service = NoteService()
+        note_id = service.create("alice", "shopping list")
+        service.share("alice", note_id, "bob")
+        with self.assertRaises(PermissionDenied):
+            service.share("bob", note_id, "carol")
+        with self.assertRaises(PermissionDenied):
+            service.read("carol", note_id)
+
+    def test_share_missing_note_is_not_found(self):
+        with self.assertRaises(NotFound):
+            NoteService().share("alice", 99, "bob")
+
 
 if __name__ == "__main__":
     unittest.main()
