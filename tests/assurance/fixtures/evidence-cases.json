    {"id": "evidence-older-than-max-age", "both": {"timestamps": ["2026-09-01T00:00:00Z"]}, "verdict": "fail", "reasons": ["stale-evidence"]},
    {"id": "timestamp-in-the-future", "both": {"timestamps": ["2026-12-25T00:00:00Z"]}, "verdict": "fail", "reasons": ["stale-evidence"]},
    {"id": "no-test-result", "test_result": null, "verdict": "fail", "reasons": ["missing-attestation:test-result"]},
    {"id": "no-provenance", "provenance": null, "verdict": "fail", "reasons": ["missing-attestation:provenance"]},
    {"id": "no-verified-timestamp", "test_result": {"timestamps": []}, "verdict": "fail", "reasons": ["missing-timestamp"]},
    {"id": "prompt-stored-in-evidence", "test_result": {"predicate": {"prompt": "fictional prompt text"}}, "verdict": "fail", "reasons": ["unexpected-content"]},
