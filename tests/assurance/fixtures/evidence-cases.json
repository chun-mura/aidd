{
  "_comment": "Fictional gh attestation verify --format json entries for verify_evidence.py. evidence-test.sh builds one passing provenance and one passing test-result entry from the same run, then applies each case's overrides: 'both' to both entries, 'provenance' / 'test_result' to one (null removes it), 'extra' adds entries. In overrides, cert keys replace certificate fields, 'subject' and 'artifact_in_config' / 'criteria_in_config' take ARTIFACT, OTHER or a digest, 'predicate' merges into the test-result predicate, 'timestamps' replaces the verified timestamps.",
  "cases": [
    {"id": "all-bound", "verdict": "pass", "reasons": []},
    {"id": "distributed-file-differs", "artifact": "tampered", "verdict": "fail", "reasons": ["digest-mismatch:provenance", "digest-mismatch:test-result", "input-mismatch"]},
    {"id": "tests-ran-on-another-build", "test_result": {"subject": "OTHER", "artifact_in_config": "OTHER"}, "verdict": "fail", "reasons": ["digest-mismatch:test-result", "input-mismatch"]},
    {"id": "signed-by-the-app-repository-workflow", "provenance": {"cert": {"buildSignerURI": "https://github.com/example-org/example-app/.github/workflows/release.yml@refs/tags/v1.2.3"}}, "verdict": "fail", "reasons": ["signer-mismatch"]},
    {"id": "other-oidc-issuer", "both": {"cert": {"issuer": "https://issuer.example.invalid"}}, "verdict": "fail", "reasons": ["issuer-mismatch"]},
    {"id": "self-hosted-runner", "both": {"cert": {"runnerEnvironment": "self-hosted"}}, "verdict": "fail", "reasons": ["environment-mismatch"]},
    {"id": "other-source-repository", "both": {"cert": {"sourceRepositoryURI": "https://github.com/example-org/fork-of-app"}}, "verdict": "fail", "reasons": ["source-mismatch"]},
    {"id": "evidence-of-an-older-commit", "both": {"cert": {"sourceRepositoryDigest": "4444444444444444444444444444444444444444"}}, "verdict": "fail", "reasons": ["source-mismatch"]},
    {"id": "built-from-a-branch", "both": {"cert": {"sourceRepositoryRef": "refs/heads/feature"}}, "verdict": "fail", "reasons": ["ref-mismatch"]},
    {"id": "tested-against-changed-criteria", "test_result": {"criteria_in_config": "OTHER"}, "verdict": "fail", "reasons": ["input-mismatch"]},
    {"id": "tests-failed", "test_result": {"predicate": {"result": "FAILED", "failedTests": ["AT-PAY-01"]}}, "verdict": "fail", "reasons": ["tests-not-passed"]},
    {"id": "passed-label-with-failures", "test_result": {"predicate": {"failedTests": ["AT-PAY-01"]}}, "verdict": "fail", "reasons": ["tests-not-passed"]},
    {"id": "nothing-passed", "test_result": {"predicate": {"passedTests": []}}, "verdict": "fail", "reasons": ["tests-not-passed"]},
