      {"kind": "test_result", "cert": {"runInvocationURI": "https://github.com/example-org/example-app/actions/runs/500/attempts/1"}, "timestamps": ["2026-08-01T00:00:00Z"]}
    ], "verdict": "fail", "reasons": ["stale-evidence"]}
  ]
