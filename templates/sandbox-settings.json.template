{
  "permissions": {
    "blockWritesOutsideWorkingDirectories": true,
    "deny": [
      "Bash(gh extension *)",
      "Bash(gh alias *)",
      "Bash(gh pr checkout *)",
      "Bash(gh repo clone *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["gh *"],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" }
      ]
    }
  }
}
