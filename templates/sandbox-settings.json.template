{
  "permissions": {
    "blockWritesOutsideWorkingDirectories": true,
    "ask": [
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm -f -r*)",
      "Bash(rm -f -R*)",
      "Bash(rm --recursive*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)"
    ],
    "deny": [
      "Bash(gh extension *)",
      "Bash(gh alias *)",
      "Bash(gh pr checkout *)",
      "Bash(gh repo clone *)",
      "Bash(gh auth token *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth setup-git *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh release *)",
      "Bash(gh * release *)",
      "Bash(gh run download *)",
      "Bash(gh gist *)",
      "Bash(gh run delete *)",
      "Bash(gh cache delete *)",
      "Bash(gh codespace *)",
      "Bash(gh config set *)",
      "Bash(gh browse*)",
      "Bash(gh * browse*)",
      "Bash(gh * --web*)",
      "Bash(gh * -w*)",
      "Bash(gh api --hostname*)",
      "Bash(gh api * --hostname*)",
      "Bash(gh api http*)",
      "Bash(gh api * http*)",
      "Bash(gh pr merge*)",
      "Bash(gh * pr merge*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.gem/credentials)",
      "Read(~/.terraform.d/credentials.tfrc.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["gh *"],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.git-credentials", "mode": "deny" },
        { "path": "~/.config/git/credentials", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" },
        { "path": "~/.pypirc", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" },
        { "path": "~/.kube/config", "mode": "deny" },
        { "path": "~/.config/gcloud", "mode": "deny" },
        { "path": "~/.azure", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.cargo/credentials.toml", "mode": "deny" },
        { "path": "~/.gem/credentials", "mode": "deny" },
        { "path": "~/.terraform.d/credentials.tfrc.json", "mode": "deny" }
      ]
    }
  }
}
