---------------------------- MODULE TraceCheck ----------------------------
(* Checks that one recorded implementation trace is a behavior of Publish.
   TraceData (generated by impl/publish_service.py) defines Trace, a sequence of
   [op |-> <<name, arg>>, state |-> abstract state after that operation];
   Trace[1] has op <<"Init", "none">> and the state of the freshly created store.
   Each step must be the named model action AND reach exactly the recorded state.
   When a step cannot be matched, no TraceNext disjunct is enabled and TLC
   reports a deadlock at that step; a fully matched trace ends in stuttering. *)
EXTENDS Publish, Sequences, Naturals, TraceData

VARIABLE i   \* number of trace elements matched so far

MatchesNext(k) ==
    /\ verified' = Trace[k].state.verified
    /\ approved' = Trace[k].state.approved
    /\ published' = Trace[k].state.published
    /\ pending' = Trace[k].state.pending

ActionOf(op) ==
    CASE op[1] = "Verify"  -> Verify(op[2])
      [] op[1] = "Approve" -> Approve(op[2])
      [] op[1] = "Revoke"  -> Revoke(op[2])
      [] op[1] = "Modify"  -> Modify(op[2])
      [] op[1] = "Check"   -> Check(op[2][1], op[2][2])
      [] op[1] = "Publish" -> Publish(op[2])
      [] op[1] = "Crash"   -> Crash(op[2])

TraceInit == Init /\ i = 0

TraceNext ==
    \/ /\ i = 0                                   \* the initial store maps to Init
       /\ UNCHANGED vars
       /\ MatchesNext(1)
       /\ i' = 1
    \/ /\ 0 < i /\ i < Len(Trace)
       /\ ActionOf(Trace[i + 1].op)
       /\ MatchesNext(i + 1)
       /\ i' = i + 1
    \/ /\ i = Len(Trace)
       /\ UNCHANGED <<vars, i>>

TraceSpec == TraceInit /\ [][TraceNext]_<<vars, i>>

=============================================================================
