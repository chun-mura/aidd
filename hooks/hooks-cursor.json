{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Shell",
        "command": "./hooks/scripts/harness-adapter.sh tool-reminder.sh"
      },
      {
        "matcher": "Write",
        "command": "./hooks/scripts/harness-adapter.sh write-guard.sh"
      }
    ],
    "postToolUse": [
      {
        "matcher": "Shell",
        "command": "./hooks/scripts/harness-adapter.sh tool-reminder.sh"
      }
    ],
    "postToolUseFailure": [
      {
        "matcher": "Shell",
        "command": "./hooks/scripts/harness-adapter.sh tool-reminder.sh"
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/scripts/harness-adapter.sh session-start.sh"
      }
    ]
  }
}
